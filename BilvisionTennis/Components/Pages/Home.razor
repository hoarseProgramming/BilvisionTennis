@page "/"
@using BilvisionTennis.Frontend.TennisGame
@inject GlobalStore GlobalStore
@inject NavigationManager NavigationManager
@inject ITennisClient TennisClient

<PageTitle>Pocket Umpire</PageTitle>
<MudPaper Height="50vh" Class="d-flex justify-center">
    <MudImage Height="200" Width="1000" Src="Images/pumpire.webp"></MudImage>
</MudPaper>
<MudPaper Height="50vh" Width="100%" Class="d-flex justify-center align-center">


    <MudStack style="width: 500px">
        <MudStack Row>
            <MudTextField Label="Enter new Umpire name" @bind-value="NewUmpireName" Variant="Variant.Outlined"></MudTextField>
            <MudButton OnClick="AddUmpire">Create</MudButton>
        </MudStack>
        <MudSelect @ref="_umpireSelect" T="Umpire" Label="Choose Umpire" Variant="Variant.Outlined" @bind-Value="_choosenUmpire">
            @foreach(var umpire in umpires)
            {
                <MudSelectItem Value="@umpire">@umpire.Name</MudSelectItem>
            }

        </MudSelect>
        <MudItem xs="12">
            <div class="d-flex align-center justify-center">
                <MudButton Disabled=@(_choosenUmpire is null)
                            Variant="Variant.Filled"
                           Color="Color.Primary" 
                           OnClick=NavigateToMatchSettings>
                           Go to match settings
                       </MudButton>
            </div>
        </MudItem>
        <MudItem xs="12">
            <div class="d-flex align-center justify-center">
                <MudButton Disabled=@(_choosenUmpire is null || _choosenUmpire.Matches.Count == 0) Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick=NavigateToOldMatches>
                    Browse old matches
                </MudButton>
            </div>
        </MudItem>
    </MudStack>
</MudPaper>


@code{
    public string NewUmpireName { get; set; } = "";
    private string _pathToPumpire = System.AppDomain.CurrentDomain.BaseDirectory.Replace(@"bin\Debug\net9.0\", @"Components\Images\pumpire.webp");
    private List<Umpire> umpires = new();
    private Umpire? _choosenUmpire
    {
        get => _selectedUmpire;
        set
        {
            _selectedUmpire = value;
            GlobalStore.OldMatches = _selectedUmpire?.Matches ?? new();
        }
    }
    private Umpire? _selectedUmpire;
    private MudSelect<Umpire> _umpireSelect;

    protected override async Task OnInitializedAsync()
    {
        var result = await TennisClient.GetUmpires.ExecuteAsync();
        umpires = result.Data?.Umpires.Select(u => new Umpire(TennisClient, GlobalStore)
            {
                Id = u.Id,
                Name = u.Name,
                Matches = u.Matches.Select(m => new TennisMatch(
                    new Player { Name = m.Players[0].Name },
                    new Player { Name = m.Players[1].Name },
                    new Umpire(TennisClient, GlobalStore) {Id = u.Id, Name = u.Name},
                    0,
                    m.Id
                )
                {
                    Winner = new Player { Name = m.Winner?.Name ?? "None" },
                    Sets = m.Games.Select(g => new Set
                    {
                        Number = g.Number,
                        Games = g.Sets.Select(s => new Game
                        {
                            Number = s.Number,
                            Rallies = s.Rallies.Select(r => new Rally
                            {
                                Number = r.ShotNumber,
                                Winner = new Player
                                {
                                    Name = r.Scorer.Name
                                }
                            }).ToList()
                        }).ToList()
                    }).ToList()
                }).ToList()
            }).ToList() ?? [];      
    }
    private async Task AddUmpire()
    {
        var createResult = await TennisClient.AddUmpire.ExecuteAsync(new AddUmpireInput
        {
            Name = NewUmpireName
        });

        if (createResult.IsErrorResult())
        {
            return;
        }

        var umpire = new Umpire(TennisClient, GlobalStore)
            {
                Id = createResult.Data.AddUmpire.Umpire.Id,
                Name = createResult.Data.AddUmpire.Umpire.Name
            };

        umpires.Add(umpire);
        _choosenUmpire = umpire;
    }

    private void NavigateToMatchSettings()
    {
        GlobalStore.Umpire = _choosenUmpire;
        NavigationManager.NavigateTo("match-settings");
    }

    private void NavigateToOldMatches()
    {
        GlobalStore.Umpire = _choosenUmpire;
        NavigationManager.NavigateTo("old-matches");
    }
}