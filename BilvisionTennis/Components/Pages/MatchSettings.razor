@page "/match-settings"
@using BilvisionTennis.Frontend.TennisGame
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject GlobalStore GlobalStore
@inject ITennisClient TennisClient


<PageTitle>Match Settings</PageTitle>
<MudPaper Height="50vh" Class="d-flex justify-center">
    <MudImage Height="200" Width="1000" Src="Images/pumpire.webp"></MudImage>
</MudPaper>
<MudPaper Height="50vh" Width="100%" Class="d-flex justify-center align-end">

    <MudGrid Justify="Justify.SpaceEvenly" Class="ma-2">
        <MudItem xs="8">
            <MudTextField T="string" @bind-Value="_newPlayerName" Label="New Player"></MudTextField>
        </MudItem>
        <MudItem xs="4">

            <MudButton OnClick="AddPlayer">Create</MudButton>
        </MudItem>
        <MudItem xs="6">
        <MudSelect @ref="_playerOneSelect" Label="Choose Player 1" @bind-Value="_playerOneValue" Variant="Variant.Outlined">
            @foreach (var player in Players)
            {
                <MudSelectItem Value="@player">@player.Name</MudSelectItem>
            }

        </MudSelect>

        </MudItem>
        <MudItem xs="6">

        <MudSelect @ref="_playerTwoSelect" Label="Choose Player 2" @bind-Value="_playerTwoValue" Variant="Variant.Outlined">
            @foreach (var player in Players)
            {
                <MudSelectItem Value="@player">@player.Name</MudSelectItem>
            }

        </MudSelect>

        </MudItem>
        <MudItem xs="4">
            <MudTextField T="string" @bind-text="GlobalStore.Umpire.Name" Disabled="true" Label="Umpire"></MudTextField>
        </MudItem>
        <MudItem xs="4">
            <MudTextField  @bind-Value="GlobalStore.NumberOfSetsInGame" T="int" HelperText="Enter number of sets in match"></MudTextField>
        </MudItem>
        <MudItem xs="12">
            <div class="d-flex align-center justify-center">
                <MudButton Disabled="@(_playerOneValue is null || _playerTwoValue is null)" Variant="Variant.Filled"
                           Color="Color.Primary" 
                           OnClick="NavigateToMatch">New Match!</MudButton>
            </div>
        </MudItem>

    </MudGrid>
</MudPaper>


@code{
    private string _pathToPumpire = System.AppDomain.CurrentDomain.BaseDirectory.Replace(@"bin\Debug\net9.0\", @"Components\Images\pumpire.webp");
    private string _newPlayerName = string.Empty;
    private Player? _playerOneValue = null;
    private Player? _playerTwoValue = null;
    private List<Player> Players = [];
    private MudSelect<Player> _playerOneSelect;
    private MudSelect<Player> _playerTwoSelect;

    private async Task NavigateToMatch()
    {
        GlobalStore.PlayerOne = _playerOneValue;
        GlobalStore.PlayerTwo = _playerTwoValue;


        Umpire umpire = GlobalStore.Umpire;

        int numberOfSets = GlobalStore.NumberOfSetsInGame == 0 ? 5 : GlobalStore.NumberOfSetsInGame;

        var addMatchResult = await TennisClient.AddMatch.ExecuteAsync(new AddMatchInput
            {
                Players = [_playerOneValue.Id, _playerTwoValue.Id],
                UmpireId = umpire.Id
            });

        TennisMatch newMatch = new(_playerOneValue, _playerTwoValue, umpire, numberOfSets, addMatchResult.Data.AddMatch.Match.Id);
        await newMatch.Umpire.StartNewMatch(addMatchResult.Data.AddMatch.Match.Games[0].Id, addMatchResult.Data.AddMatch.Match.Games[0].Sets[0].Id);
        GlobalStore.CurrentMatch = newMatch;
        NavigationManager.NavigateTo("Match");
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var playersResult = await TennisClient.GetPlayers.ExecuteAsync();

        Players = playersResult.Data?.Players.Select(p => new Player
        {
            Id = p.Id,
            Name = p.Name
        }).ToList() ?? [];
    }

    private async Task AddPlayer()
    {
        var createResult = await TennisClient.AddPlayer.ExecuteAsync(new AddPlayerInput
        {
            Name = _newPlayerName
        });

        if (createResult.IsErrorResult())
        {
            return;
        }

        var player = new Player
        {
            Id = createResult.Data.AddPlayer.Player.Id,
            Name = createResult.Data.AddPlayer.Player.Name
        };

        Players.Add(player);
        if (_playerOneValue is not null && _playerTwoValue is not null) return;

        if (_playerOneValue is null)
        {
            _playerOneValue = player;
        } else
        {
            _playerTwoValue = player;

        }
    }

}