@page "/Match"
@rendermode InteractiveServer


@using BilvisionTennis.Frontend.TennisGame
@using BilvisionTennis.Frontend.Components.RazorComponents
@inject GlobalStore GlobalStore
<PageTitle>Match!</PageTitle>
@inject NavigationManager NavigationManager

<MudGrid>
	<MudItem xs="12">
		<Scoreboard @ref="_scoreboard" Score="@_score"></Scoreboard>
	</MudItem>

	<MudItem xs="6">
		<div class="d-flex align-center justify-end">
			<MudButton @ref="_scorePointToPlayerOneButton"
				Variant="Variant.Filled"
				Color="Color.Primary"
				Disabled="GlobalStore.CurrentMatch.CurrentSet.CurrentGame.HasWinner"
				OnClick="@((e) => OnButtonClicked(_scorePointToPlayerOneButton, 1))">
				@GlobalStore.PlayerOne.Name Scored
			</MudButton>
		</div>
	</MudItem>
	<MudItem xs="6">
		<div class="d-flex align-center justify-start">
			<MudButton @ref="_scorePointToPlayerTwoButton"
				Variant="Variant.Filled"
				Color="Color.Primary"
					   Disabled="GlobalStore.CurrentMatch.CurrentSet.CurrentGame.HasWinner"
					   OnClick="@((e) => OnButtonClicked(_scorePointToPlayerTwoButton, 2))">
				@GlobalStore.PlayerTwo.Name Scored
			</MudButton>
		</div>
	</MudItem>
	<MudItem xs="6">
		<div class="d-flex align-center justify-end">
			<MudButton @ref="_startNextGameButton"
				Variant="Variant.Filled"
				Color="Color.Primary"
					   Disabled="!GlobalStore.CurrentMatch.CurrentSet.CurrentGame.HasWinner ||GlobalStore.CurrentMatch.CurrentSet.HasWinner"
				OnClick="@((e) => OnButtonClicked(_startNextGameButton))">
				Start next game!
			</MudButton>
		</div>
	</MudItem>
	<MudItem xs="6">
		<div class="d-flex align-center justify-start">
			<MudButton @ref="_startNextSetButton"
				Variant="Variant.Filled"
				Color="Color.Primary"
					   Disabled="!GlobalStore.CurrentMatch.CurrentSet.HasWinner || GlobalStore.CurrentMatch.Winner is not null"
				OnClick="@((e) => OnButtonClicked(_startNextSetButton))">
				Start next set!
			</MudButton>
		</div>
	</MudItem>
	<MudItem xs="12">
		<div class="d-flex justify-center">
			<h3>Umpire: @GlobalStore.CurrentMatch.Umpire.Name  |   Server: @(GlobalStore.CurrentMatch.PlayerOne.IsServer? GlobalStore.CurrentMatch.PlayerOne.Name : GlobalStore.CurrentMatch.PlayerTwo.Name)</h3>
		</div>
	</MudItem>
	<MudItem xs="12">
		<div class="d-flex justify-center">
			<h3>Call to make: @GlobalStore.CurrentMatch.CurrentSet.CurrentGame.VerbalScore</h3>
		</div>
	</MudItem>

	<MudItem  xs="12">
		<div class="d-flex align-center justify-center">
			<MudButton Variant="Variant.Filled"
					   Color="Color.Primary"
					   OnClick=NavigateToSettings
					   Class=@(GlobalStore.CurrentMatch.Winner is null ? "invisible" : "")>
				Go to match settings
			</MudButton>
		</div>
	</MudItem>

</MudGrid>

@code {


	private string _score = string.Empty;
	private Scoreboard _scoreboard = new();

	private MudButton _scorePointToPlayerOneButton = new();
	private MudButton _scorePointToPlayerTwoButton = new();
	private MudButton _startNextGameButton = new();
	private MudButton _startNextSetButton = new();

	protected override void OnInitialized()
	{
		base.OnInitialized();


		_score = GlobalStore.CurrentMatch?.Score();
	}

	private async Task OnButtonClicked(MudButton buttonClicked, int playerNumber = 0)
	{
		if (buttonClicked == _scorePointToPlayerOneButton)
		{
			GlobalStore.CurrentMatch.Umpire.ScorePointToPlayer(1);
		}
		else if (buttonClicked == _scorePointToPlayerTwoButton)
		{
			GlobalStore.CurrentMatch.Umpire.ScorePointToPlayer(2);
		}
		else if (buttonClicked == _startNextGameButton)
		{
			await GlobalStore.CurrentMatch.Umpire.StartNewGame();
			// StateHasChanged();
		}
		else
		{
			await GlobalStore.CurrentMatch.Umpire.StartNewSet();
			// StateHasChanged();

		}

		_scoreboard.Score = GlobalStore.CurrentMatch.Score();
		_scoreboard.Update();

		StateHasChanged();
	}

	private void NavigateToSettings()
	{
		NavigationManager.NavigateTo("match-settings");
	}
}